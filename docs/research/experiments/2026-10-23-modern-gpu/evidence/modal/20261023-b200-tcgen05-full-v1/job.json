{
  "sources": [
    "tools/research/cuda/tcgen05_probe.cu",
    "tools/research/cuda/tcgen05_validate.py",
    "tools/research/cuda/tcgen05_run_probe.py"
  ],
  "commands": [
    {
      "name": "tcgen05_full",
