{
  "sources": [
    "tools/research/cuda/tma_version_probe.cu",
    "tools/research/cuda/tma_run_probe.py",
    "tools/research/cuda/tcgen05_probe.cu"
  ],
  "commands": [
    {
      "name": "tma_smoke",
      "argv": [
        "python3",
        "tma_run_probe.py",
        "--output",
        "tma-smoke",
        "--cuda-root",
        "/usr/local/cuda",
        "--arch",
        "sm_100a",
        "--smoke",
        "--skip-sanitizers"
      ],
      "timeout": 90
    },
    {
      "name": "tc_compile",
      "argv": [
        "nvcc",
        "-std=c++17",
        "-O3",
        "-lineinfo",
        "-arch=sm_100a",
        "tcgen05_probe.cu",
        "-o",
        "tcgen05_probe"
      ],
      "timeout": 60
    },
    {
      "name": "tc_smoke",
      "argv": [
        "./tcgen05_probe",
        "1",
        "7",
        "correct"
      ],
      "timeout": 35
    }
  ],
  "artifact_patterns": [
    "tma-smoke/*",
    "tcgen05_probe"
  ]
}
