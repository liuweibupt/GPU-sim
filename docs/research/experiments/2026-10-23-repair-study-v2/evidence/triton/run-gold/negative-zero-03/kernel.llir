; Function Attrs: nounwind
define ptx_kernel void @constant_kernel(ptr addrspace(1) %0, ptr addrspace(1) readnone captures(none) %1, ptr addrspace(1) readnone captures(none) %2) local_unnamed_addr #0 !dbg !4 {
  %4 = tail call i32 @llvm.nvvm.read.ptx.sreg.tid.x(), !dbg !11
  %5 = and i32 %4, 63, !dbg !11
  %6 = zext nneg i32 %5 to i64, !dbg !12
  %7 = getelementptr [2 x i8], ptr addrspace(1) %0, i64 %6, !dbg !12
  %8 = and i32 %4, 64, !dbg !13
  %9 = icmp eq i32 %8, 0, !dbg !13
  tail call void asm sideeffect "@$2 st.global.b16 [ $1 + 0 ], { $0 };", "c,l,b"(i16 -32768, ptr addrspace(1) %7, i1 %9) #2, !dbg !13
  ret void, !dbg !14
}

