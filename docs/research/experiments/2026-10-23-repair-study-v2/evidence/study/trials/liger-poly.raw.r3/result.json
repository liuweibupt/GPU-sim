          },
          {
            "line": 12,
            "text": "from liger_kernel.utils import is_npu_available"
          },
          {
            "line": 13,
            "text": ""
          },
          {
            "line": 14,
            "text": "if compare_version(\"triton\", operator.ge, \"3.0.0\") and not is_npu_available():"
          },
          {
            "line": 15,
            "text": "    try:"
          },
          {
