          },
          {
            "line": 18,
            "text": "        from triton.language.extra.cuda.libdevice import rsqrt"
          },
          {
            "line": 19,
            "text": "else:"
          },
          {
            "line": 20,
            "text": "    from triton.language.math import rsqrt"
