            "text": "    \"\"\""
          },
          {
            "line": 82,
            "text": "    Transforms the indices of a row-major `size_i * size_j` matrix into"
          },
          {
            "line": 83,
            "text": "    the indices of a column-major matrix for each group of `size_g` rows."
          },
          {
            "line": 84,
            "text": ""
          },
          {
            "line": 85,
            "text": "    For example, for :code:`size_i = size_j = 4` and :code:`size_g = 2`, it will"
          },
          {
            "line": 86,
            "text": "    transform ::"
          },
          {
            "line": 87,
            "text": ""
          },
          {
            "line": 88,
            "text": "        [[0 , 1 , 2 , 3 ],"
          },
          {
            "line": 89,
            "text": "         [4 , 5 , 6 , 7 ],"
          },
          {
            "line": 90,
            "text": "         [8 , 9 , 10, 11],"
          },
          {
            "line": 91,
            "text": "         [12, 13, 14, 15]]"
          },
          {
            "line": 92,
            "text": ""
          },
          {
            "line": 93,
            "text": "    into ::"
          },
          {
            "line": 94,
            "text": ""
          },
          {
            "line": 95,
            "text": "        [[0, 2,  4 , 6 ],"
          },
          {
            "line": 96,
            "text": "         [1, 3,  5 , 7 ],"
          },
          {
            "line": 97,
            "text": "         [8, 10, 12, 14],"
          },
          {
            "line": 98,
            "text": "         [9, 11, 13, 15]]"
          },
          {
            "line": 99,
            "text": "    \"\"\""
          },
          {
            "line": 100,
            "text": "    # \"unrolled index in array\""
          },
          {
            "line": 101,
            "text": "    ij = i * size_j + j"
          },
          {
            "line": 102,
            "text": "    # number of elements in `size_g` groups"
          },
          {
            "line": 103,
            "text": "    # of `size_j` columns"
          },
          {
            "line": 104,
            "text": "    size_gj = size_g * size_j"
          },
          {
            "line": 105,
            "text": "    # index of the group in which (i,j) is"
          },
          {
            "line": 106,
            "text": "    group_id = ij // size_gj"
          },
          {
            "line": 107,
            "text": "    # row-index of the first element of this group"
          },
          {
            "line": 108,
            "text": "    off_i = group_id * size_g"
          },
          {
            "line": 109,
            "text": "    # last group may have fewer rows"
          },
          {
            "line": 110,
            "text": "    size_g = core.minimum(size_i - off_i, size_g)"
          },
          {
            "line": 111,
            "text": "    # linear index with respect to the first element in this group"
          },
          {
            "line": 112,
            "text": "    ij = ij % size_gj"
          },
          {
            "line": 113,
            "text": "    # new row and column indices"
          },
          {
            "line": 114,
            "text": "    new_i = off_i + ij % size_g"
          },
          {
            "line": 115,
            "text": "    new_j = ij // size_g"
          },
          {
            "line": 116,
            "text": "    return new_i, new_j"
          },
          {
            "line": 117,
            "text": ""
          },
          {
            "line": 118,
            "text": ""
          },
          {
            "line": 119,
