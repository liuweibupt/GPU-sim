          {
            "line": 69,
            "text": "def ravel(x, can_reorder=False):"
          },
          {
            "line": 70,
            "text": "    \"\"\""
          },
          {
            "line": 71,
            "text": "    Returns a contiguous flattened view of :code:`x`."
