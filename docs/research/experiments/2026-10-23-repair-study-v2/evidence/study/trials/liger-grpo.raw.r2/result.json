            "text": "    if MASK is not None:"
          },
          {
            "line": 44,
            "text": "        MASK += off_b * stride_input_ids_b + off_l"
          },
          {
            "line": 45,
            "text": "        not_skip = tl.load(MASK)"
          },
          {
            "line": 46,
            "text": "        if not_skip == 0:"
          },
          {
            "line": 47,
            "text": "            return"
          },
          {
            "line": 48,
            "text": ""
          },
          {
            "line": 49,
            "text": "    m_i = float(\"-inf\")"
          },
          {
            "line": 50,
            "text": "    l_i = 0.0"
          },
          {
            "line": 51,
            "text": "    for start in range(0, N, BLOCK_N):"
          },
          {
            "line": 52,
            "text": "        cols = start + tl.arange(0, BLOCK_N)"
          },
          {
            "line": 53,
            "text": "        logits = tl.load(LOGITS + cols, mask=cols < N, other=float(\"-inf\")).to(tl.float32) / TEMPERATURE"
          },
          {
            "line": 54,
            "text": "        new_m_i = tl.maximum(m_i, tl.max(logits))"
          },
          {
            "line": 55,
            "text": "        alpha = tl.exp(m_i - new_m_i)"
          },
          {
            "line": 56,
            "text": "        l_i = l_i * alpha + tl.sum(tl.exp(logits - new_m_i))"
