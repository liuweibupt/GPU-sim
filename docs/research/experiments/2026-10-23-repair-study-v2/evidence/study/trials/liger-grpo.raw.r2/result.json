          {
            "line": 67,
            "text": "@torch.no_grad"
          },
          {
            "line": 68,
            "text": "def fused_selective_log_softmax(logits: torch.Tensor, input_ids: torch.Tensor, temperature: float = 0.9, mask=None):"
