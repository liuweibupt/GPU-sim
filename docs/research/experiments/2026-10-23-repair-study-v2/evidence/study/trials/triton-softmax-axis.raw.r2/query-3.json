      },
      {
        "line": 55,
        "text": "@math._add_math_1arg_docstr(\"softmax\")"
      },
      {
        "line": 56,
        "text": "def softmax(x, dim=None, keep_dims=False, ieee_rounding=False):"
      },
      {
        "line": 57,
        "text": "    if dim is None:"
      },
      {
        "line": 58,
        "text": "        _dim: core.constexpr = 0"
      },
      {
        "line": 59,
        "text": "    else:"
      },
      {
        "line": 60,
        "text": "        _dim: core.constexpr = dim"
      },
      {
        "line": 61,
        "text": "    z = x - max(x, _dim, keep_dims=keep_dims)"
      },
      {
        "line": 62,
        "text": "    num = math.exp(z)"
      },
      {
        "line": 63,
        "text": "    den = sum(num, _dim, keep_dims=keep_dims)"
      },
      {
        "line": 64,
        "text": "    return math.fdiv(num, den, ieee_rounding)"
      },
      {
        "line": 65,
        "text": ""
      },
      {
        "line": 66,
        "text": ""
      },
      {
