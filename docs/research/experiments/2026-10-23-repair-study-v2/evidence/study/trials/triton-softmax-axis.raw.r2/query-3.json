      {
        "line": 34,
        "text": "def cdiv(x, div):"
      },
      {
        "line": 35,
        "text": "    \"\"\""
      },
      {
        "line": 36,
        "text": "    Computes the ceiling division of :code:`x` by :code:`div`"
      },
      {
        "line": 37,
        "text": ""
      },
      {
        "line": 38,
        "text": "    :param x: the input number"
      },
      {
        "line": 39,
        "text": "    :type x: Block"
      },
      {
        "line": 40,
        "text": "    :param div: the divisor"
      },
      {
        "line": 41,
        "text": "    :type div: Block"
      },
      {
        "line": 42,
        "text": "    \"\"\""
      },
      {
        "line": 43,
        "text": "    return (x + (div - 1)) // div"
      },
      {
        "line": 44,
        "text": ""
      },
      {
        "line": 45,
        "text": ""
      },
      {
