          },
          {
            "line": 80,
            "text": "def swizzle2d(i, j, size_i, size_j, size_g):"
          },
          {
            "line": 81,
            "text": "    \"\"\""
          },
          {
            "line": 82,
            "text": "    Transforms the indices of a row-major `size_i * size_j` matrix into"
          },
          {
            "line": 83,
            "text": "    the indices of a column-major matrix for each group of `size_g` rows."
          },
          {
            "line": 84,
            "text": ""
          },
          {
            "line": 85,
            "text": "    For example, for :code:`size_i = size_j = 4` and :code:`size_g = 2`, it will"
          },
          {
            "line": 86,
            "text": "    transform ::"
          },
          {
            "line": 87,
            "text": ""
          },
          {
            "line": 88,
            "text": "        [[0 , 1 , 2 , 3 ],"
          },
          {
            "line": 89,
            "text": "         [4 , 5 , 6 , 7 ],"
          },
          {
            "line": 90,
            "text": "         [8 , 9 , 10, 11],"
          },
          {
            "line": 91,
            "text": "         [12, 13, 14, 15]]"
          },
          {
            "line": 92,
            "text": ""
          },
          {
            "line": 93,
            "text": "    into ::"
          },
          {
            "line": 94,
            "text": ""
          },
          {
            "line": 95,
            "text": "        [[0, 2,  4 , 6 ],"
          },
          {
            "line": 96,
            "text": "         [1, 3,  5 , 7 ],"
          },
          {
            "line": 97,
            "text": "         [8, 10, 12, 14],"
          },
          {
            "line": 98,
            "text": "         [9, 11, 13, 15]]"
          },
