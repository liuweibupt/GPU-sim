            "line": 111,
            "text": "    # linear index with respect to the first element in this group"
          },
          {
            "line": 112,
            "text": "    ij = ij % size_gj"
          },
          {
            "line": 113,
            "text": "    # new row and column indices"
          },
          {
            "line": 114,
            "text": "    new_i = off_i + ij % size_g"
          },
          {
            "line": 115,
            "text": "    new_j = ij // size_g"
          },
          {
            "line": 116,
            "text": "    return new_i, new_j"
