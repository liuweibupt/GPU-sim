      },
      {
        "line": 4,
        "text": "@triton.jit"
      },
      {
        "line": 5,
        "text": "def filter_kernel(Y,VALUES:tl.constexpr,CUTOFF:tl.constexpr,EVEN:tl.constexpr):"
      },
      {
        "line": 6,
        "text": "    if EVEN:"
      },
      {
        "line": 7,
        "text": "        vals:tl.constexpr=[x for x in VALUES if x>=CUTOFF if x%2==0]"
      },
      {
        "line": 8,
        "text": "    else:"
      },
      {
        "line": 9,
        "text": "        vals:tl.constexpr=[x for x in VALUES if x>=CUTOFF]"
      },
      {
        "line": 10,
        "text": "    tl.store(Y,len(vals))"
      },
      {
        "line": 11,
        "text": "    for i in tl.static_range(len(vals)):"
      },
      {
        "line": 12,
        "text": "        tl.store(Y+1+i,vals[i])"
      },
