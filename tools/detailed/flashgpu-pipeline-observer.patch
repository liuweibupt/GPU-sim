+void shader_core_ctx::pipeline_observe(const char *event,
+                                      const warp_inst_t &inst,
+                                      const char *native_unit, int unit_index,
+                                      int issue_partition, int collector_id) {
+  static const bool enabled = getenv("GPU_SIM_PIPELINE_OBSERVER") != NULL &&
+      strcmp(getenv("GPU_SIM_PIPELINE_OBSERVER"), "1") == 0;
+  if (!enabled || inst.empty()) return;
+  // The capture runner fixes OMP_NUM_THREADS=1; flockfile also keeps each JSONL
+  // record intact with respect to upstream stdout diagnostics.
+  flockfile(stdout);
+  static std::set<unsigned> configured_sms;
+  if (configured_sms.insert(m_sid).second) {
+    std::ostringstream config;
+    config << "FLASHGPU_PIPELINE_CONFIG {\"schemaVersion\":1,\"smId\":" << m_sid
+           << ",\"subCoreModel\":" << (m_config->sub_core_model ? "true" : "false")
+           << ",\"schedulerCount\":" << m_config->gpgpu_num_sched_per_core
+           << ",\"registerBankCount\":" << m_config->gpgpu_num_reg_banks
+           << ",\"genericCollectorCount\":" << m_config->gpgpu_operand_collector_num_units_gen
+           << ",\"schedulerPartitionMap\":[";
+    if (m_config->sub_core_model) {
+      for (unsigned i = 0; i < m_config->gpgpu_num_sched_per_core; ++i) {
+        if (i) config << ',';
+        config << i;
+      }
+    }
+    config << "],\"unitComponentMap\":{\"SP\":\"fp32\",\"INT\":\"int32\","
+              "\"DP\":\"fp64\",\"SFU\":\"sfu\",\"TENSOR_CORE\":\"tensor\","
+              "\"MEM\":\"lsu\"},\"nativeUnits\":[";
+    for (unsigned n = 0; n < m_num_function_units; ++n) {
+      if (n) config << ',';
+      const bool partitioned = m_config->sub_core_model &&
+                               m_fu[n]->is_issue_partitioned();
+      config << "{\"index\":" << n << ",\"name\":"
+             << pipeline_json_string(m_fu[n]->get_name())
+             << ",\"issuePartitioned\":" << (partitioned ? "true" : "false");
+      if (partitioned)
+        config << ",\"issuePartitionId\":" << m_fu[n]->get_issue_reg_id();
+      config << '}';
+    }
+    config << "]}";
+    printf("%s\n", config.str().c_str());
+  }
+  std::ostringstream line;
+  line << "FLASHGPU_PIPELINE {\"schemaVersion\":1,\"cycle\":"
+       << m_gpu->gpu_tot_sim_cycle + m_gpu->gpu_sim_cycle
+       << ",\"smId\":" << m_sid << ",\"warpId\":" << inst.warp_id()
+       << ",\"dynamicWarpId\":" << inst.dynamic_warp_id()
+       << ",\"dynamicInstructionId\":\"flashgpu:uid-" << inst.get_uid() << '"'
+       << ",\"pc\":\"0x" << std::hex << inst.pc << std::dec << '"'
+       << ",\"event\":" << pipeline_json_string(event)
+       << ",\"schedulerId\":" << inst.get_schd_id();
+  if (m_config->sub_core_model)
+    line << ",\"partitionId\":" << inst.get_schd_id();
+  line << ",\"nativeOp\":"
+       << pipeline_json_string(Trace::instruction_issue_op_name(inst.op))
+       << ",\"activeMask\":\"0x" << std::hex
+       << inst.get_active_mask().to_ullong() << std::dec << '"'
+       << ",\"instructionText\":" << pipeline_json_string(
+              m_config->gpgpu_ctx->func_sim->ptx_get_insn_str(inst.pc));
+  if (native_unit != NULL)
+    line << ",\"nativeUnit\":" << pipeline_json_string(native_unit);
+  if (unit_index >= 0) line << ",\"nativeUnitIndex\":" << unit_index;
+  if (issue_partition >= 0)
+    line << ",\"nativeIssuePartitioned\":true,\"nativeIssuePartitionId\":"
+         << issue_partition;
+  else if (unit_index >= 0)
+    line << ",\"nativeIssuePartitioned\":false";
+  if (collector_id >= 0) line << ",\"collectorId\":" << collector_id;
+  line << '}';
+  printf("%s\n", line.str().c_str());
+  funlockfile(stdout);
+}
